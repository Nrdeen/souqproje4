# Example Nginx reverse proxy configuration for SouqAlGhanam 2.0 (سوق الغنم 2.0)
# Terminate TLS at Nginx/CDN and forward HTTP + WebSocket traffic to Express on 127.0.0.1:3000.
# Pair with TRUST_PROXY="1" (or "2" if behind Cloudflare + Nginx) in the Express environment.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream souqalghanam_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name souqalghanam.example.sa www.souqalghanam.example.sa;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name souqalghanam.example.sa;

    # TLS certificates managed via Certbot / Let's Encrypt or Cloud Origin CA
    ssl_certificate     /etc/letsencrypt/live/souqalghanam.example.sa/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/souqalghanam.example.sa/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    # Must exceed max video upload limit (25 MB) + JSON/multipart framing overhead
    client_max_body_size 30m;

    # Keepalive and upload timeouts
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    # Security proxy headers forwarded to Express
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket notifications endpoint (/ws)
    location = /ws {
        proxy_pass http://souqalghanam_app;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Private authorization-gated media uploads & video byte-range streaming
    location ^~ /api/v1/media/ {
        proxy_pass http://souqalghanam_app;
        proxy_set_header Connection "";
        # Disable response buffering so 206 Partial Content byte-range video streams immediately
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Static hashed Vite assets (long cache)
    location ^~ /assets/ {
        proxy_pass http://souqalghanam_app;
        proxy_set_header Connection "";
        expires 365d;
        add_header Cache-Control "public, immutable" always;
    }

    # Application & API traffic
    location / {
        proxy_pass http://souqalghanam_app;
        proxy_set_header Connection "";
    }
}
